{
  "name": "huddle",
  "version": "1.0.0",
  "description": "Huddle voice calls",
  "author": {
    "name": "Huddle",
    "email": "noreply@example.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:mac": "electron-builder --mac dir --x64 --arm64 --publish never",
    "build:linux": "electron-builder --linux deb --x64 --arm64 --publish never"
  },
  "build": {
    "appId": "com.huddle.app",
    "productName": "Huddle",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "mac": {
      "identity": null,
      "category": "public.app-category.social-networking",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Huddle needs the microphone for voice calls."
      }
    },
    "linux": {
      "target": "deb",
      "category": "Network",
      "synopsis": "Voice calls and messages"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "homepage": "https://github.com/"
}
